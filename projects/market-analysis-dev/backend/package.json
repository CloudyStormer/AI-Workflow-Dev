{
  "name": "frontend-career-radar-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/apps/api/main.ts",
    "start": "node dist/apps/api/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
