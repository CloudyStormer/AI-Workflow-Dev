{
  "name": "frontend-career-radar-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/apps/api/main.ts",
    "start": "node dist/apps/api/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests scripts --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:migration": "NODE_OPTIONS=--experimental-sqlite vitest run tests/unit/migration-manifest.test.ts tests/integration/migration-runtime.test.ts",
    "test:integration": "NODE_OPTIONS=--experimental-sqlite vitest run tests/integration",
    "test:data": "NODE_OPTIONS=--experimental-sqlite vitest run tests/integration/material-analysis-store.test.ts tests/integration/verified-batch-importer.test.ts",
    "smoke:data": "NODE_OPTIONS=--experimental-sqlite tsx scripts/data-smoke.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
