{
  "name": "ai-model-radar-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests vitest.config.ts --ignore-pattern 'src/policy/**' --deny-warnings",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:unit",
    "test:unit": "node --test src/policy/*.test.mjs && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "tsx": "4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}
